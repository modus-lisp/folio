(asdf:load-system "folio")
(in-package :folio)
(defun rfb (path)
  (with-open-file (f path :element-type '(unsigned-byte 8))
    (let ((v (make-array (file-length f) :element-type '(unsigned-byte 8))))
      (read-sequence v f) v)))
(let ((doc (parse-pdf (rfb "test/text-test.pdf"))))
  (render-page-to-png doc 0 "test/out-text-test.png" :scale 2.0)
  (format t "~&wrote out-text-test.png~%"))
