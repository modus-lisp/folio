(asdf:load-system "folio")
(in-package :folio)
(defun rfb (path)
  (with-open-file (f path :element-type '(unsigned-byte 8))
    (let ((v (make-array (file-length f) :element-type '(unsigned-byte 8))))
      (read-sequence v f) v)))
(dolist (nm '("a-rect" "b-flate" "c-xrefstm" "d-array"))
  (let ((doc (parse-pdf (rfb (format nil "test/~a.pdf" nm)))))
    (render-page-to-png doc 0 (format nil "test/out-~a.png" nm) :scale 2.0)
    (format t "~&~a ok~%" nm)))
