(asdf:load-system "folio")
(in-package :folio)
(defun rfb (path)
  (with-open-file (f path :element-type '(unsigned-byte 8))
    (let ((v (make-array (file-length f) :element-type '(unsigned-byte 8))))
      (read-sequence v f) v)))
(let* ((doc (parse-pdf (rfb "test/real-sample.pdf")))
       (page (get-page doc 0)))
  (format t "~&mediabox: ~a~%" (page-mediabox page))
  (let* ((res (page-resources page))
         (fonts (resolve doc (dict-get res "Font"))))
    (when (hash-table-p fonts)
      (loop for k being the hash-keys of fonts using (hash-value v)
            for fd = (resolve doc v) do
        (format t "  /~a Subtype=~a BaseFont=~a Enc=~a Widths?~a First=~a~%"
          k
          (let ((s (resolve doc (dict-get fd "Subtype")))) (and (pdf-name-p s) (pdf-name-string s)))
          (let ((s (resolve doc (dict-get fd "BaseFont")))) (and (pdf-name-p s) (pdf-name-string s)))
          (let ((s (resolve doc (dict-get fd "Encoding")))) (cond ((pdf-name-p s) (pdf-name-string s)) ((hash-table-p s) :dict) (t s)))
          (and (dict-get fd "Widths") t)
          (resolve doc (dict-get fd "FirstChar"))))))
  (let ((cb (page-content-bytes page)))
    (format t "~%content (~a bytes):~%~a~%" (length cb)
            (map 'string #'code-char (subseq cb 0 (min 600 (length cb)))))))
