(asdf:load-system "folio")
(in-package :folio)
(defun rfb (path)
  (with-open-file (f path :element-type '(unsigned-byte 8))
    (let ((v (make-array (file-length f) :element-type '(unsigned-byte 8))))
      (read-sequence v f) v)))
(let* ((doc (parse-pdf (rfb "test/real-arxiv.pdf")))
       (page (get-page doc 0))
       (res (page-resources page))
       (fonts (resolve doc (dict-get res "Font"))))
  (when (hash-table-p fonts)
    (loop for k being the hash-keys of fonts using (hash-value v)
          for fd = (resolve doc v)
          for desc = (resolve doc (dict-get fd "FontDescriptor")) do
      (format t "~&/~a Subtype=~a Base=~a FF1=~a FF2=~a FF3=~a~%" k
        (let ((s (resolve doc (dict-get fd "Subtype")))) (and (pdf-name-p s) (pdf-name-string s)))
        (let ((s (resolve doc (dict-get fd "BaseFont")))) (and (pdf-name-p s) (pdf-name-string s)))
        (and (hash-table-p desc) (dict-get desc "FontFile") t)
        (and (hash-table-p desc) (dict-get desc "FontFile2") t)
        (and (hash-table-p desc) (dict-get desc "FontFile3") t))
      (let ((pf (ignore-errors (load-simple-font doc fd))))
        (format t "    -> face=~a embedded=~a~%" (and pf (pdf-font-face pf) t) (and pf (pdf-font-embedded pf))))))
  (render-page-to-png doc 0 "test/out-arxiv.png" :scale 1.5)
  (format t "~&wrote out-arxiv.png~%"))
